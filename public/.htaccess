# Techzapp CRM — public_html configuration (Apache / LiteSpeed, as used by Hostinger)
#
# Layout this file assumes:
#   public_html/              <- this directory (frontend build + entry points)
#   public_html/api/index.php <- API front controller
#   ../private/backend/       <- application code, vendor, config, storage
#
# If your private directory is somewhere else, set CRM_BACKEND_PATH below.

# SetEnv CRM_BACKEND_PATH /home/uXXXXXXX/domains/example.com/private/backend

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ---------------------------------------------------------------- HTTPS
    # Session cookies are issued with the Secure flag, so the app only works
    # over HTTPS. Comment this out only for local HTTP development.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # ------------------------------------------------------------------ API
    # Everything under /api/v1 is handled by one front controller.
    RewriteRule ^api/v1/.*$ api/index.php [L,QSA]

    # ------------------------------------------------- SPA history fallback
    # Real files and directories are served as-is; everything else returns the
    # React entry point so client-side routing works on a hard refresh.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/t/
    RewriteCond %{REQUEST_URI} !^/u/
    RewriteCond %{REQUEST_URI} !^/webhooks/
    RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------- headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

    # HSTS. Enable once you are certain HTTPS works on every hostname.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # The SPA shell must never be cached, or a deploy leaves users on old code.
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-store, must-revalidate"
    </FilesMatch>

    # Hashed assets are immutable.
    <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Tracking and unsubscribe responses must never be cached by a proxy.
    <FilesMatch "^(o|c|index)\.php$">
        Header set Cache-Control "no-store"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
        application/javascript application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------- hardening
# Nothing sensitive should be inside public_html at all, but deny the obvious
# shapes in case a file is uploaded here by mistake.
<FilesMatch "(^\.|\.(env|ini|log|sql|sh|bak|swp|dist|json\.example)$|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(config|\.env.*|.*\.sql)$">
    Require all denied
</FilesMatch>

# Deny access to a backend directory if one was uploaded here by accident.
RedirectMatch 404 ^/(backend|vendor|storage|migrations|cron|tests)(/|$)

# ------------------------------------------------------------------ PHP
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
</IfModule>

ErrorDocument 404 /index.html
