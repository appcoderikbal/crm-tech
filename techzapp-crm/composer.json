{
    "name": "techzapp/crm-wordpress-plugin",
    "description": "Techzapp CRM — email marketing for WordPress with Amazon SES",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "aws/aws-sdk-php": "^3.300",
        "aws/aws-php-sns-message-validator": "^1.10",
        "ezyang/htmlpurifier": "^4.17"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": { "php": "8.2.0" }
    },
    "autoload": {
        "psr-4": { "TechzappCrm\\": "includes/" }
    }
}
