# Secrets — never commit
backend/config/config.php
.env
*.pem
*.key

# Dependencies
backend/vendor/
frontend/node_modules/

# The plugin's bundled libraries are a build artefact. They ship inside the
# release ZIP (shared hosting cannot run Composer) but do not belong in git:
# the AWS SDK alone is ~70 MB of service definitions we mostly delete.
techzapp-crm/vendor/
build/

# Build output
frontend/dist/
frontend/*.tsbuildinfo
public/assets/
public/index.html

# Runtime state
backend/storage/logs/*
backend/storage/imports/*
backend/storage/sessions/*
backend/storage/tmp/*
!backend/storage/*/.gitignore

# Tooling
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db
.phpunit.cache/
