# This repository is the plugin. Its contents are what WordPress installs, so
# almost nothing is excluded — including vendor/, which has to ship because
# shared hosting cannot run Composer. It is the stripped bundle produced by
# bin/install-vendor.sh (~8 MB), not a plain `composer install` (~72 MB).

# Build output
/build/

# Local development only, never part of a release
docker-compose*.yml
.wp-env.json
*.local.php

# Secrets must never be committed. Credentials belong in wp-config.php.
.env
*.pem
*.key

# Tooling and OS noise
/node_modules/
.idea/
.vscode/
*.log
*.tsbuildinfo
.DS_Store
Thumbs.db
.phpunit.cache/
.phpunit.result.cache
